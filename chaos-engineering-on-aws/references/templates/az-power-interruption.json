{
  "description": "AZ Power Interruption (based on the official FIS Scenario Library az-availability-scenario content) - stop EC2/ASG instances, ICE errors, 2-min subnet disruption, RDS failover, ElastiCache AZ power interruption, then pause EBS IO in one AZ",
  "targets": {
    "IAM-role": {
      "resourceType": "aws:iam:role",
      "resourceArns": ["{{instanceLaunchRoleArn}}"],
      "selectionMode": "ALL"
    },
    "EC2-Instances": {
      "resourceType": "aws:ec2:instance",
      "resourceTags": {
        "AzImpairmentPower": "StopInstances"
      },
      "filters": [
        {
          "path": "State.Name",
          "values": ["running"]
        },
        {
          "path": "Placement.AvailabilityZone",
          "values": ["{{availabilityZone}}"]
        }
      ],
      "selectionMode": "ALL"
    },
    "ASG": {
      "resourceType": "aws:ec2:autoscaling-group",
      "resourceTags": {
        "AzImpairmentPower": "IceAsg"
      },
      "selectionMode": "ALL"
    },
    "ASG-EC2-Instances": {
      "resourceType": "aws:ec2:instance",
      "resourceTags": {
        "AzImpairmentPower": "IceAsg"
      },
      "filters": [
        {
          "path": "State.Name",
          "values": ["running"]
        },
        {
          "path": "Placement.AvailabilityZone",
          "values": ["{{availabilityZone}}"]
        }
      ],
      "selectionMode": "ALL"
    },
    "Subnet": {
      "resourceType": "aws:ec2:subnet",
      "resourceTags": {
        "AzImpairmentPower": "DisruptSubnet"
      },
      "filters": [
        {
          "path": "AvailabilityZone",
          "values": ["{{availabilityZone}}"]
        }
      ],
      "selectionMode": "ALL"
    },
    "RDS-Cluster": {
      "resourceType": "aws:rds:cluster",
      "resourceTags": {
        "AzImpairmentPower": "DisruptRds"
      },
      "selectionMode": "ALL",
      "parameters": {
        "writerAvailabilityZoneIdentifiers": "{{availabilityZone}}"
      }
    },
    "ElastiCache-Cluster": {
      "resourceType": "aws:elasticache:replicationgroup",
      "resourceTags": {
        "AzImpairmentPower": "DisruptElasticache"
      },
      "selectionMode": "ALL",
      "parameters": {
        "availabilityZoneIdentifier": "{{availabilityZone}}"
      }
    },
    "EBS-Volumes": {
      "resourceType": "aws:ec2:ebs-volume",
      "resourceTags": {
        "AzImpairmentPower": "ApiPauseVolume"
      },
      "selectionMode": "COUNT(1)",
      "parameters": {
        "availabilityZoneIdentifier": "{{availabilityZone}}"
      },
      "filters": [
        {
          "path": "Attachments.DeleteOnTermination",
          "values": ["false"]
        }
      ]
    }
  },
  "actions": {
    "Pause-Instance-Launches": {
      "actionId": "aws:ec2:api-insufficient-instance-capacity-error",
      "description": "Prune unit: this action + target IAM-role. ICE errors for RunInstances/StartInstances/CreateFleet made by the listed (non-service-linked) roles in the AZ",
      "parameters": {
        "availabilityZoneIdentifiers": "{{availabilityZone}}",
        "duration": "{{interruptionDuration}}",
        "percentage": "100"
      },
      "targets": {
        "Roles": "IAM-role"
      }
    },
    "Stop-Instances": {
      "actionId": "aws:ec2:stop-instances",
      "description": "Prune unit: this action + target EC2-Instances. Stop standalone instances in the AZ, restart after the interruption",
      "parameters": {
        "completeIfInstancesTerminated": "true",
        "startInstancesAfterDuration": "{{interruptionDuration}}"
      },
      "targets": {
        "Instances": "EC2-Instances"
      }
    },
    "Pause-ASG-Scaling": {
      "actionId": "aws:ec2:asg-insufficient-instance-capacity-error",
      "description": "Prune unit: this action + target ASG. ICE errors for the ASG control plane in the AZ (no re-scaling of compute there)",
      "parameters": {
        "availabilityZoneIdentifiers": "{{availabilityZone}}",
        "duration": "{{interruptionDuration}}",
        "percentage": "100"
      },
      "targets": {
        "AutoScalingGroups": "ASG"
      }
    },
    "Stop-ASG-Instances": {
      "actionId": "aws:ec2:stop-instances",
      "description": "Prune unit: this action + target ASG-EC2-Instances. Stop ASG-managed instances in the AZ, restart after the interruption",
      "parameters": {
        "completeIfInstancesTerminated": "true",
        "startInstancesAfterDuration": "{{interruptionDuration}}"
      },
      "targets": {
        "Instances": "ASG-EC2-Instances"
      }
    },
    "Pause-network-connectivity": {
      "actionId": "aws:network:disrupt-connectivity",
      "description": "Prune unit: this action + target Subnet. Block all traffic of tagged subnets in the AZ (official default PT2M, the DNS-update window)",
      "parameters": {
        "duration": "{{networkDisruptionDuration}}",
        "scope": "all"
      },
      "targets": {
        "Subnets": "Subnet"
      }
    },
    "Failover-RDS": {
      "actionId": "aws:rds:failover-db-cluster",
      "description": "Prune unit: this action + target RDS-Cluster. Fail over tagged clusters whose writer is in the AZ",
      "parameters": {},
      "targets": {
        "Clusters": "RDS-Cluster"
      }
    },
    "Pause-ElastiCache": {
      "actionId": "aws:elasticache:replicationgroup-interrupt-az-power",
      "description": "Prune unit: this action + target ElastiCache-Cluster. Interrupt power to nodes in the AZ of tagged Multi-AZ replication groups",
      "parameters": {
        "duration": "{{interruptionDuration}}"
      },
      "targets": {
        "ReplicationGroups": "ElastiCache-Cluster"
      }
    },
    "Wait-Before-EBS-Pause": {
      "actionId": "aws:fis:wait",
      "description": "Prune unit with Pause-EBS-IO (delete both together). Replaces the official startAfter on the two stop actions so stop actions can be pruned independently",
      "parameters": {
        "duration": "{{interruptionDuration}}"
      }
    },
    "Pause-EBS-IO": {
      "actionId": "aws:ebs:pause-volume-io",
      "description": "Prune unit: this action + Wait-Before-EBS-Pause + target EBS-Volumes. Recovery-phase symptom: one unresponsive volume after power returns",
      "parameters": {
        "duration": "{{interruptionDuration}}"
      },
      "targets": {
        "Volumes": "EBS-Volumes"
      },
      "startAfter": ["Wait-Before-EBS-Pause"]
    }
  },
  "stopConditions": [
    {
      "source": "aws:cloudwatch:alarm",
      "value": "{{stopConditionAlarmArn}}"
    }
  ],
  "roleArn": "{{fisRoleArn}}",
  "experimentOptions": {
    "accountTargeting": "single-account",
    "emptyTargetResolutionMode": "skip"
  },
  "tags": {
    "Name": "AZ Impairment: Power Interruption",
    "Purpose": "chaos-engineering",
    "Scenario": "az-power-interruption"
  }
}
